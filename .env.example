# Copy this file to ".env" and keep the values (or change the password).
# Docker Compose and the Python code both read from ".env".

POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight_pw
POSTGRES_DB=finsight

# Python (running on your machine) connects to this host/port.
# 5433 is used on purpose so it does not clash with a PostgreSQL you may
# already have installed locally on the default port 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Data generator defaults (can also be overridden with command-line flags)
FINSIGHT_SEED=42

# Financial control thresholds (Phase 2) - optional, these are the defaults
CONTROL_VARIANCE_THRESHOLD_PCT=15
CONTROL_HIGH_VALUE_INR=100000
CONTROL_CRITICAL_VALUE_INR=250000
CONTROL_AMOUNT_TOLERANCE=0.01

# Reconciliation (Phase 3) - ledger may post 0..N calendar days after the transaction date
RECON_DATE_TOLERANCE_DAYS=4
